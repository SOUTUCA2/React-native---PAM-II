{
  "expo": {
    "name": "Rota Express",
    "slug": "rota-express",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.pamii.rotaexpress"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "defaultChannel": "entregas",
          "color": "#F97316"
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "DeliveryStatusWidget",
              "label": "Status da entrega",
              "description": "Acompanhe o status e o tempo estimado do pedido.",
              "minWidth": "250dp",
              "minHeight": "120dp",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 0
            }
          ]
        }
      ]
    ]
  }
}
